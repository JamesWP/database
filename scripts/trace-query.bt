#!/usr/bin/env bpftrace
//
// Per-query trace log: SQL text, VM operations, and page I/O call stacks.
//
// Requires debug symbols AND frame pointers for full stack unwinding.
// Build with: RUSTFLAGS="-C force-frame-pointers=yes" cargo build
// Run queries with: RUSTFLAGS="-C force-frame-pointers=yes" cargo run -- <db_file> sql "..."
//
// Without force-frame-pointers, ustack() will only show 1-2 frames.
//
// Usage:
//   sudo bpftrace scripts/trace-query.bt
//   # In another terminal (with frame pointers):
//   RUSTFLAGS="-C force-frame-pointers=yes" cargo run -- <db_file> sql "<your query>"
//
// Or via: make trace-query
//   # Builds with frame pointers and launches the script.
//   # Run your query in a second terminal with the same RUSTFLAGS.
//
// For release binary: rebuild with debug = 1 in [profile.release]
// and change the binary path below to ./target/release/database.

// ─── Query start ─────────────────────────────────────────────────────────────

usdt:./target/debug/database:database:query_start {
    printf("\n[query] %s\n", str(arg0, arg1));
}

// ─── VM operations ───────────────────────────────────────────────────────────

usdt:./target/debug/database:database:engine_opcode {
    printf("  [op] %s\n", str(arg0, arg1));
}

// ─── Page reads by type ───────────────────────────────────────────────────────

usdt:./target/debug/database:database:page_read_leaf {
    printf("    [page_read: leaf  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_read_interior {
    printf("    [page_read: interior  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_read_overflow {
    printf("    [page_read: overflow  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_read_zero {
    printf("    [page_read: zero-page  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_read_freelist {
    printf("    [page_read: freelist  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

// ─── Page writes by type ──────────────────────────────────────────────────────

usdt:./target/debug/database:database:page_write_leaf {
    printf("    [page_write: leaf  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_write_interior {
    printf("    [page_write: interior  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_write_overflow {
    printf("    [page_write: overflow  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_write_zero {
    printf("    [page_write: zero-page  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

usdt:./target/debug/database:database:page_write_freelist {
    printf("    [page_write: freelist  page=%d]\n", arg0);
    printf("%s\n", ustack());
}

// ─── Cache hits / misses (no stack — high frequency, informational only) ─────

usdt:./target/debug/database:database:page_read_cache_hit {
    printf("    [cache: HIT]\n");
}

usdt:./target/debug/database:database:page_read_cache_miss {
    printf("    [cache: MISS]\n");
}

// ─── Row mutations ────────────────────────────────────────────────────────────

usdt:./target/debug/database:database:row_insert {
    printf("    [row_insert]\n");
}

usdt:./target/debug/database:database:row_delete {
    printf("    [row_delete]\n");
}

// ─── Overflow chain reads ─────────────────────────────────────────────────────

usdt:./target/debug/database:database:overflow_read {
    printf("    [overflow_read: page=%d]\n", arg0);
    printf("%s\n", ustack());
}
